# Free key from https://www.themoviedb.org/settings/api
# Either the "API Key" (v3) or the "API Read Access Token" (v4, starts with eyJ) works.
TMDB_API_KEY=

# Port the addon listens on.
PORT=7000

# Interface to listen on. Defaults to 127.0.0.1 (this computer only).
# Set to 0.0.0.0 when hosting it for other devices (the Docker image does this).
HOST=

# Public https:// address of this server when hosted behind a proxy that
# doesn't pass the Host / X-Forwarded-Proto headers. Usually not needed.
PUBLIC_URL=
